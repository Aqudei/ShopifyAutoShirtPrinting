<dryIoc:PrismApplication x:Class="ShopifyEasyShirtPrinting.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dryIoc="http://prismlibrary.com/" 
                         DispatcherUnhandledException="PrismApplication_DispatcherUnhandledException" >
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- MahApps.Metro resource dictionaries. Make sure that all file names are Case Sensitive! -->
                <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/Controls.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/Fonts.xaml" />
                <!-- Theme setting -->
                <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/Themes/Light.Orange.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Application Message Colors -->
            <SolidColorBrush x:Key="Message.InfoBrush" Color="{DynamicResource MahApps.Colors.Accent}" />
            <SolidColorBrush x:Key="Message.WarningBrush" Color="#E6A700" />
            <SolidColorBrush x:Key="Message.ErrorBrush" Color="#D32F2F" />
            <SolidColorBrush x:Key="Message.SuccessBrush" Color="#388E3C" />
        </ResourceDictionary>
    </Application.Resources>
</dryIoc:PrismApplication>
