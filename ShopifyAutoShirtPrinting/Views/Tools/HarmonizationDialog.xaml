<UserControl x:Class="ShopifyEasyShirtPrinting.Views.Tools.HarmonizationDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:ShopifyEasyShirtPrinting.Views.Tools" xmlns:ico="http://metro.mahapps.com/winfx/xaml/iconpacks" mc:Ignorable="d" d:DesignHeight="450" d:DesignWidth="800">
    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <!-- ========================================================= -->
        <!-- HEADER -->
        <!-- ========================================================= -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,25">
            <ico:PackIconFontAwesome Kind="PenToSquareRegular" Width="28" Height="28" VerticalAlignment="Center" Margin="0,0,12,0" />
            <StackPanel>
                <TextBlock Text="Harmonization Item" FontSize="22" FontWeight="SemiBold" />
                <TextBlock Text="Create or edit a harmonization item" FontSize="13" Opacity="0.65" Margin="0,3,0,0" />
            </StackPanel>
        </StackPanel>
        <!-- ========================================================= -->
        <!-- CODE -->
        <!-- ========================================================= -->
        <TextBlock Grid.Row="1" Text="Code" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,6" />
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="36" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <!-- Code Icon -->
            <Border Grid.Column="0" Height="36" VerticalAlignment="Top">
                <ico:PackIconFontAwesome Kind="HashtagSolid" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBox Grid.Column="1" Text="{Binding Code}" Height="36" VerticalContentAlignment="Center" Padding="8,0" />
        </Grid>
        <!-- ========================================================= -->
        <!-- DESCRIPTION -->
        <!-- ========================================================= -->
        <TextBlock Grid.Row="3" Text="Description" FontSize="14" FontWeight="SemiBold" Margin="0,20,0,6" />
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="36" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <!-- Description Icon -->
            <Border Grid.Column="0" VerticalAlignment="Top" Height="36">
                <ico:PackIconFontAwesome Kind="AlignLeftSolid" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBox Grid.Column="1" MinLines="4" Text="{Binding Description}" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Padding="8" />
        </Grid>
        <!-- ========================================================= -->
        <!-- ACTIONS -->
        <!-- ========================================================= -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,25,0,0">
            <!-- Save -->
            <Button Command="{Binding DialogCommand}" CommandParameter="Save" Height="36" MinWidth="100" Margin="0,0,8,0" ToolTip="Save changes">
                <StackPanel Orientation="Horizontal">
                    <ico:PackIconFontAwesome Kind="FloppyDiskSolid" Width="15" Height="15" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Text="Save" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <!-- Save And Add -->
            <Button Command="{Binding DialogCommand}" CommandParameter="SaveAndAddd" Height="36" MinWidth="135" Margin="0,0,8,0" ToolTip="Save this item and add another">
                <StackPanel Orientation="Horizontal">
                    <ico:PackIconFontAwesome Kind="FloppyDiskSolid" Width="15" Height="15" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <ico:PackIconFontAwesome Kind="PlusSolid" Width="11" Height="11" Margin="2,0,7,0" VerticalAlignment="Center" />
                    <TextBlock Text="Save And Add" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <!-- Close -->
            <Button Command="{Binding DialogCommand}" CommandParameter="Close" Height="36" MinWidth="100" ToolTip="Close without saving">
                <StackPanel Orientation="Horizontal">
                    <ico:PackIconFontAwesome Kind="XmarkSolid" Width="15" Height="15" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Text="Close" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>