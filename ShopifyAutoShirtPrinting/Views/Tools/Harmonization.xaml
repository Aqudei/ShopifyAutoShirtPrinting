<UserControl
    x:Class="ShopifyEasyShirtPrinting.Views.Tools.Harmonization"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:ShopifyEasyShirtPrinting.Views.Tools"
    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
    mah:DialogParticipation.Register="{Binding}"
    xmlns:ico="http://metro.mahapps.com/winfx/xaml/iconpacks"
    mc:Ignorable="d"
    d:DesignHeight="450"
    d:DesignWidth="800">

    <Grid Margin="10">

        <Grid.RowDefinitions>
            <!-- Toolbar -->
            <RowDefinition Height="Auto" />

            <!-- Data -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ========================================================= -->
        <!-- TOOLBAR -->
        <!-- ========================================================= -->
        <Border
            Grid.Row="0"
            Margin="0,0,0,10"
            Padding="10"
            CornerRadius="4"
            BorderThickness="1"
            BorderBrush="{DynamicResource MahApps.Brushes.Gray5}">

            <DockPanel LastChildFill="False">

                <!-- Title -->
                <StackPanel
                    DockPanel.Dock="Left"
                    Orientation="Horizontal"
                    VerticalAlignment="Center"
                    Margin="0,0,20,0">

                    <ico:PackIconFontAwesome
                        Kind="BoxesStackedSolid"
                        Width="22"
                        Height="22"
                        VerticalAlignment="Center"
                        Margin="0,0,10,0" />

                    <TextBlock
                        Text="Harmonization"
                        FontSize="18"
                        FontWeight="SemiBold"
                        VerticalAlignment="Center" />

                </StackPanel>

                <!-- Actions -->
                <StackPanel
                    DockPanel.Dock="Right"
                    Orientation="Horizontal"
                    VerticalAlignment="Center">

                    <!-- Import -->
                    <!--
                    <Button
                        Width="120"
                        Height="34"
                        Margin="0,0,8,0"
                        Command="{Binding ImportCommand}"
                        ToolTip="Import items from Excel">

                        <StackPanel Orientation="Horizontal">
                            <ico:PackIconFontAwesome
                                Kind="FileExcelRegular"
                                Width="16"
                                Height="16"
                                Margin="0,0,8,0"
                                VerticalAlignment="Center" />

                            <TextBlock
                                Text="Import"
                                VerticalAlignment="Center" />
                        </StackPanel>

                    </Button>
                    -->

                    <!-- New Item -->
                    <Button
                        Width="120"
                        Height="34"
                        Margin="0,0,8,0"
                        Command="{Binding NewItemCommand}"
                        ToolTip="Create a new harmonization item">

                        <StackPanel Orientation="Horizontal">

                            <ico:PackIconFontAwesome
                                Kind="PlusSolid"
                                Width="15"
                                Height="15"
                                Margin="0,0,8,0"
                                VerticalAlignment="Center" />

                            <TextBlock
                                Text="New Item"
                                VerticalAlignment="Center" />

                        </StackPanel>

                    </Button>

                    <!-- Delete -->
                    <Button
                        Width="140"
                        Height="34"
                        Margin="0,0,8,0"
                        Command="{Binding DeleteSelectedCommand}"
                        ToolTip="Delete selected items">

                        <StackPanel Orientation="Horizontal">

                            <ico:PackIconFontAwesome
                                Kind="TrashCanRegular"
                                Width="15"
                                Height="15"
                                Margin="0,0,8,0"
                                VerticalAlignment="Center" />

                            <TextBlock
                                Text="Delete Selected"
                                VerticalAlignment="Center" />

                        </StackPanel>

                    </Button>

                    <!-- Refresh -->
                    <Button
                        Width="110"
                        Height="34"
                        Command="{Binding RefreshCommand}"
                        ToolTip="Refresh harmonization items">

                        <StackPanel Orientation="Horizontal">

                            <ico:PackIconFontAwesome
                                Kind="ArrowsRotateSolid"
                                Width="15"
                                Height="15"
                                Margin="0,0,8,0"
                                VerticalAlignment="Center" />

                            <TextBlock
                                Text="Refresh"
                                VerticalAlignment="Center" />

                        </StackPanel>

                    </Button>

                </StackPanel>

            </DockPanel>

        </Border>


        <!-- ========================================================= -->
        <!-- DATA GRID -->
        <!-- ========================================================= -->
        <DataGrid
            Grid.Row="1"
            ItemsSource="{Binding HarmonizationItems}"
            AutoGenerateColumns="False"
            IsReadOnly="True"
            CanUserAddRows="False"
            CanUserDeleteRows="False"
            CanUserResizeRows="False"
            SelectionMode="Single"
            SelectionUnit="FullRow"
            HeadersVisibility="Column"
            GridLinesVisibility="Horizontal"
            Margin="0">

            <DataGrid.Columns>

                <!-- Selection -->
                <DataGridTemplateColumn
                    Width="55"
                    CanUserSort="False">

                    <DataGridTemplateColumn.Header>
                        <ico:PackIconFontAwesome
                            Kind="CheckSolid"
                            Width="13"
                            Height="13"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
                    </DataGridTemplateColumn.Header>

                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>

                            <CheckBox
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                IsChecked="{Binding IsSelected,
                                                    Mode=TwoWay,
                                                    UpdateSourceTrigger=PropertyChanged}" />

                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>

                </DataGridTemplateColumn>


                <!-- Code -->
                <DataGridTextColumn
                    Header="Code"
                    Binding="{Binding Code}"
                    Width="180" />


                <!-- Description -->
                <DataGridTextColumn
                    Header="Description"
                    Binding="{Binding Description}"
                    Width="*" />

            </DataGrid.Columns>

        </DataGrid>

    </Grid>
</UserControl>