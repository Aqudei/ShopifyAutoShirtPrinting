<UserControl
    x:Class="ShopifyEasyShirtPrinting.Views.Dialogs.LoginDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
    xmlns:ico="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:converters="clr-namespace:ShopifyEasyShirtPrinting.Converters"
    mc:Ignorable="d"
    d:DesignHeight="277.935"
    d:DesignWidth="841.885">

    <UserControl.Resources>
        <converters:MessageTypeToColorConverter
            x:Key="MessageTypeToColorConverter" />

        <BooleanToVisibilityConverter
            x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>

    <!-- Prism Dialog Window -->
    <prism:Dialog.WindowStyle>
        <Style TargetType="{x:Type mah:MetroWindow}">

            <!-- Fixed dialog dimensions -->
            <Setter Property="Width"
                    Value="600" />

            <Setter Property="Height"
                    Value="278" />

            <Setter Property="MinWidth"
                    Value="600" />

            <Setter Property="MaxWidth"
                    Value="600" />

            <Setter Property="MinHeight"
                    Value="278" />

            <Setter Property="MaxHeight"
                    Value="278" />

            <!-- Prevent user resizing -->
            <Setter Property="ResizeMode"
                    Value="NoResize" />

            <Setter Property="SizeToContent"
                    Value="Manual" />

            <Setter Property="ShowInTaskbar"
                    Value="True" />
            
            <Setter Property="Title"
                    Value="{Binding Title}" />

        </Style>
    </prism:Dialog.WindowStyle>

    <Grid
        Margin="20"
        Width="560"
        Height="238">

        <Grid.ColumnDefinitions>
            <!-- Login image -->
            <ColumnDefinition Width="160" />

            <!-- Labels -->
            <ColumnDefinition Width="90" />

            <!-- Input fields -->
            <ColumnDefinition Width="*" />

            <!-- Delete button -->
            <ColumnDefinition Width="35" />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="40" />
        </Grid.RowDefinitions>

        <!-- Login Image -->
        <Image
            Grid.Row="0"
            Grid.RowSpan="4"
            Grid.Column="0"
            Width="159"
            Height="147"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Source="/Resources/padlock-login3.png" />

        <!-- Server -->
        <Label
            Grid.Row="0"
            Grid.Column="1"
            Margin="0,0,8,8"
            VerticalAlignment="Center"
            Content="Server:"
            FontSize="16" />

        <Grid
            Grid.Row="0"
            Grid.Column="2"
            Grid.ColumnSpan="2"
            Margin="0,0,0,8">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="35" />
            </Grid.ColumnDefinitions>

            <ComboBox
                x:Name="ServerComboBox"
                Grid.Column="0"
                Height="31"
                DisplayMemberPath="Url"
                FontSize="16"
                IsEditable="True"
                ItemsSource="{Binding Servers}"
                Text="{Binding SelectedServer}" />

            <Button
                Grid.Column="1"
                Width="33"
                Height="31"
                Margin="3,0,0,0"
                Command="{Binding DeleteServerCommand}"
                ToolTip="Delete selected server">

                <ico:PackIconFontAwesome Kind="TrashSolid" />

            </Button>
        </Grid>

        <!-- Username -->
        <Label
            Grid.Row="1"
            Grid.Column="1"
            Margin="0,0,8,8"
            VerticalAlignment="Center"
            Content="Username:"
            FontSize="16" />

        <TextBox
            x:Name="UserNameTextBox"
            Grid.Row="1"
            Grid.Column="2"
            Grid.ColumnSpan="2"
            Height="31"
            Margin="0,0,0,8"
            Text="{Binding UserName,
                           Mode=TwoWay,
                           UpdateSourceTrigger=PropertyChanged}"
            TextWrapping="Wrap"
            FontSize="16" />

        <!-- Password -->
        <Label
            Grid.Row="2"
            Grid.Column="1"
            Margin="0,0,8,8"
            VerticalAlignment="Center"
            Content="Password:"
            FontSize="16" />

        <PasswordBox
            x:Name="MyPasswordBox"
            Grid.Row="2"
            Grid.Column="2"
            Grid.ColumnSpan="2"
            Height="31"
            Margin="0,0,0,8"
            FontSize="16"
            PasswordChanged="MyPasswordBox_PasswordChanged">

            <PasswordBox.InputBindings>
                <KeyBinding
                    Key="Enter"
                    Command="{Binding LoginCommand}" />
            </PasswordBox.InputBindings>

        </PasswordBox>

        <!-- Message -->
        <TextBlock
            x:Name="MessageTextBlock"
            Grid.Row="3"
            Grid.Column="2"
            Grid.ColumnSpan="2"
            MinHeight="47"
            Margin="0,0,0,8"
            Text="{Binding Message.Message}"
            TextWrapping="Wrap"
            FontSize="14"
            FontWeight="Bold"
            Foreground="{Binding Message.MessageType,
                                  Converter={StaticResource MessageTypeToColorConverter}}" />

        <!-- Bottom Actions -->
        <Grid
            Grid.Row="4"
            Grid.Column="2"
            Grid.ColumnSpan="2"
            Height="40">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Busy Indicator -->
            <mah:ProgressRing
                Grid.Column="1"
                Width="36"
                Height="32"
                Margin="0,0,12,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Visibility="{Binding IsBusy,
                                     Converter={StaticResource BooleanToVisibilityConverter}}" />

            <!-- Login -->
            <Button
                x:Name="LoginButton"
                Grid.Column="2"
                Width="117"
                Height="32"
                Content="Login"
                Command="{Binding LoginCommand}"
                IsEnabled="{Binding CanLogin}" />

        </Grid>

    </Grid>
</UserControl>